# Server
PORT=3000

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local (without Docker):
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_dev?schema=public
#
# Docker Compose sets DATABASE_URL automatically for the api service
# (host is `db`, not localhost).

# Used by e2e tests (separate database recommended)
# DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_test?schema=public
